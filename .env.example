# =====================================================
# Boichitra BD (বৈচিত্র্য) — Environment Configuration
# Compatible with ProCloudify (https://procloudify.com.bd/) cPanel Node.js Hosting
# =====================================================

# 1. Database Connection (Choose Option A OR Option B)
# Option A: Single PostgreSQL Connection URL (Recommended on ProCloudify / Render / Railway)
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/boichitra_db"

# Option B: Individual PostgreSQL Credentials (cPanel PostgreSQL Databases)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="cpaneluser_boichitra"
SQL_PASSWORD="your_strong_database_password"
SQL_DB_NAME="cpaneluser_boichitradb"
SQL_SSL="false"

# 2. Admin Panel Credentials & Session Secret
ADMIN_EMAIL="admin@boichitrabd.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-string-for-boichitra-bd"

# 3. Server Runtime Settings
NODE_ENV="production"
PORT="3000"
APP_URL="https://yourdomain.com"

# 4. Business Koro (https://businesskoro.com/) Dropshipping & Auto-Product Sync
# Set your Business Koro Reseller API Key on the server (.env or cPanel Environment Variables)
BUSINESSKORO_API_KEY=""
BUSINESSKORO_API_URL="https://businesskoro.com/api/v1/products"

